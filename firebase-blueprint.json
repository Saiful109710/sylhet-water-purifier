        "paymentMethod": { "type": "string", "description": "Cash on Delivery | bKash / Nagad | Bank Transfer" },
        "status": { "type": "string", "description": "Pending | Confirmed | Installation Scheduled | Completed | Cancelled" },
        "notes": { "type": "string", "description": "Order notes" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
